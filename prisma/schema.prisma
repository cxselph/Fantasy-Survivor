// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// A single Survivor season (e.g. Season 51). Everything else hangs off one.
model Season {
  id                   Int      @id @default(autoincrement())
  number               Int      @unique // 51
  name                 String // "The Open Era"
  isActive             Boolean  @default(true)
  draftLocked          Boolean  @default(false) // once true, participants can no longer change their picks
  hideTeamsUntilLocked Boolean  @default(true) // hide every team's picks (own excepted) from everyone, admins included, until draftLocked - an admin can still temporarily reveal via an explicit override
  autoLockEnabled      Boolean  @default(false) // if true, the draft is treated as locked once autoLockAt passes, without an admin flipping draftLocked by hand
  autoLockAt           DateTime? // absolute UTC instant the draft auto-locks at; null until an admin sets one
  autoLockTimezone     String? // IANA zone (e.g. "America/New_York") the admin picked autoLockAt in, kept only to redisplay it consistently
  mergeWeek            Int? // week number merge happened; null until admin sets it
  totalWeeks           Int      @default(13) // caps the Weekly Scoring week field; admin can raise it if a season runs long
  bannerUrl            String? // shown on the login page
  backgroundUrl        String? // full-page background image, site-wide; falls back to a default gradient if unset
  backgroundDim        Int      @default(45) // 0-100, darkness of the overlay tint on top of backgroundUrl (readability)
  siteTitle            String? // shown on the login page and the nav bar once logged in; falls back to a default if unset
  accentColor          String? // hex, e.g. "#ea580c" - site-wide button/title/border theme color; falls back to the default orange if unset
  createdAt            DateTime @default(now())

  // Scoring rules, kept per-season so future seasons can change them without a migration.
  challengeWinPreMerge   Int @default(2)
  tribalSurvivePreMerge  Int @default(1)
  challengeWinPostMerge  Int @default(5)
  tribalSurvivePostMerge Int @default(2)
  firstPlacePoints       Int @default(10)
  secondPlacePoints      Int @default(5)
  thirdPlacePoints       Int @default(3)
  powerPlayerMultiplier  Int @default(2)
  powerPlayerWinBonus    Int @default(50)

  tribes      Tribe[]
  castaways   Castaway[]
  teams       FantasyTeam[]
  scoreEvents ScoreEvent[]
}

model Tribe {
  id       Int    @id @default(autoincrement())
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId Int
  name     String
  color    String @default("#6b7280") // hex color used for the tribe badge/header

  castaways Castaway[]

  @@unique([seasonId, name])
}

model Castaway {
  id        Int     @id @default(autoincrement())
  season    Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId  Int
  name      String
  bio       String?
  photoUrl  String?
  tribe     Tribe?  @relation(fields: [tribeId], references: [id], onDelete: SetNull)
  tribeId   Int?
  sortOrder Int     @default(0)

  isEliminated   Boolean @default(false)
  eliminatedWeek Int?
  placement      Int? // 1 = sole survivor, 2 = runner up, 3 = third place, etc. Set at end of season.

  picks       TeamPick[]
  scoreEvents ScoreEvent[]

  @@unique([seasonId, name])
}

// Single-row (id always 1) admin-managed SMTP config, edited from Admin -> Email Settings.
// The password is never stored in plaintext - it's AES-256-GCM encrypted with
// SETTINGS_ENCRYPTION_KEY (see src/lib/secret-cipher.ts) before it ever reaches this table.
model SmtpSettings {
  id                 Int      @id @default(1)
  host               String?
  port               Int?
  username           String?
  fromEmail          String?
  fromName           String?
  passwordCiphertext String? // base64
  passwordIv         String? // base64
  passwordAuthTag    String? // base64
  updatedAt          DateTime @updatedAt
}

enum UserRole {
  ADMIN
  MEMBER
}

// A real per-person account. Replaces the old shared-password login. Invites and password
// resets are just states of a User row (passwordHash null = invited, not yet accepted) rather
// than separate tables, matching how Season inlines its own config.
model User {
  id    Int      @id @default(autoincrement())
  email String   @unique // always stored lowercased/trimmed - normalize before every read/write
  name  String
  role  UserRole @default(MEMBER)

  passwordHash String? // null until the invite is accepted / a password is set

  invitedBy            Int?
  inviteTokenHash      String?   @unique // sha256 of the raw token emailed out; raw token is never stored
  inviteTokenExpiresAt DateTime?

  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  disabledAt          DateTime? // admin-controlled deactivation, distinct from the automatic lockout above
  sessionVersion      Int       @default(0) // bumped on password reset/unlock/disable to invalidate outstanding JWTs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams FantasyTeam[]
}

// One participant's roster for a season.
model FantasyTeam {
  id        Int      @id @default(autoincrement())
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId  Int
  ownerName String
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    Int? // null = unclaimed/historical team; set when an admin links an invited user to it
  locked    Boolean  @default(false) // set by the participant to finalize picks; only an admin can unlock
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  picks TeamPick[]

  @@unique([seasonId, ownerName])
  @@unique([seasonId, userId])
}

// A single drafted castaway on a team. Exactly 5 per team, 1 of which is flagged as Power Player.
model TeamPick {
  id            Int         @id @default(autoincrement())
  team          FantasyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId        Int
  castaway      Castaway    @relation(fields: [castawayId], references: [id], onDelete: Cascade)
  castawayId    Int
  isPowerPlayer Boolean     @default(false)

  @@unique([teamId, castawayId])
}

enum ScoreEventType {
  CHALLENGE_WIN
  TRIBAL_SURVIVE
  FINAL_PLACEMENT
  CUSTOM
}

// One scoring event for one castaway in one week, entered by an admin as episodes air.
// `points` is stored pre-computed (based on the season's rules at the time it was entered)
// so past weeks never silently change if the rules are edited later.
model ScoreEvent {
  id         Int            @id @default(autoincrement())
  season     Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId   Int
  castaway   Castaway       @relation(fields: [castawayId], references: [id], onDelete: Cascade)
  castawayId Int
  week       Int
  type       ScoreEventType
  label      String // e.g. "Won reward challenge", "Survived tribal", "Sole Survivor"
  points     Int
  createdAt  DateTime       @default(now())
}
