DATABASE_URL="postgresql://user:password@localhost:5432/fantasy_survivor?schema=public"
# Only needed in production, when DATABASE_URL is a pooled connection (Neon/Vercel Postgres
# sets this automatically). Points at the same database via its unpooled/direct connection
# string, used only for running migrations. Leave unset locally.
DATABASE_URL_UNPOOLED=""
ADMIN_PASSWORD="change-me-too" # one-time bootstrap secret, only used at /setup to claim the first real admin account
SESSION_SECRET="generate-a-long-random-string"

# Canonical base URL used to build absolute invite/reset links in emails. Only needed to override
# the default - on Vercel this falls back automatically to the production domain (in production)
# or that deployment's own preview URL (see src/lib/users.ts), so it's optional there. Only
# matters locally, where it defaults to http://localhost:3000 if unset.
APP_URL=""

# Encrypts the SMTP password an admin enters in Admin -> Email Settings before it's stored in
# the database (see src/lib/secret-cipher.ts). Generate with: openssl rand -base64 32
# Required for outgoing invite/password-reset emails; leave unset locally to have emails logged
# to the console instead of sent. SMTP host/port/username/password/from-address are configured
# through the admin UI, not env vars - swapping SMTP providers is a form edit, not a redeploy.
SETTINGS_ENCRYPTION_KEY=""

# Only needed if you want bounce tracking (Manage Users shows "Bounced" instead of just "Emailed")
# and you're using SMTP2GO specifically. HTTP Basic Auth credentials for src/app/api/webhooks/
# smtp2go - generate any random values, then enter the SAME values in SMTP2GO's dashboard under
# Settings -> Webhooks when you add a webhook pointed at https://<your-domain>/api/webhooks/smtp2go
# (Output type: JSON, Events: at least "Bounce"). Leave both unset to just not use this feature.
SMTP2GO_WEBHOOK_USER=""
SMTP2GO_WEBHOOK_PASS=""
