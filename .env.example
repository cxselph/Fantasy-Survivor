DATABASE_URL="postgresql://user:password@localhost:5432/fantasy_survivor?schema=public"
# Only needed in production, when DATABASE_URL is a pooled connection (Neon/Vercel Postgres
# sets this automatically). Points at the same database via its unpooled/direct connection
# string, used only for running migrations. Leave unset locally.
DATABASE_URL_UNPOOLED=""
SITE_PASSWORD="change-me" # legacy shared participant password - dead once real login (PR2) ships
ADMIN_PASSWORD="change-me-too" # bootstrap-only secret used once to claim the first real admin account
SESSION_SECRET="generate-a-long-random-string"

# Canonical base URL used to build absolute invite/reset links in emails. Set explicitly (rather
# than inferred from request headers) so preview deploys don't send links pointing at ephemeral
# preview URLs. Defaults to http://localhost:3000 if unset.
APP_URL="http://localhost:3000"

# Encrypts the SMTP password an admin enters in Admin -> Email Settings before it's stored in
# the database (see src/lib/secret-cipher.ts). Generate with: openssl rand -base64 32
# Required for outgoing invite/password-reset emails; leave unset locally to have emails logged
# to the console instead of sent. SMTP host/port/username/password/from-address are configured
# through the admin UI, not env vars - swapping SMTP providers is a form edit, not a redeploy.
SETTINGS_ENCRYPTION_KEY=""
